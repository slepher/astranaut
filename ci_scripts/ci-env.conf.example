# Erlang/OTP versions tested by build.ps1/build.sh and run.ps1/run.sh.
ERLANG_VSNS=21,28

# Optional Common Test selection. Names do not include the .erl suffix.
# TEST_SUITE=astranaut_design_SUITE
# TEST_CASE=lib_form_source_contracts

# Additional checks.
RUN_XREF=true
# Dialyzer is opt-in because the project currently has historical warnings.
RUN_DIALYZER=false

# auto detects a non-empty host _checkouts directory. true/false force a mode.
USE_CHECKOUTS=auto

# Output language: auto, en, or cn.
OUTPUT_LANG=auto

# Port used by the Nginx test-log viewer.
LOG_PORT=8081
