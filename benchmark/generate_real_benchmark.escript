#!/usr/bin/env escript
%%! -noshell
-mode(compile).

-define(GROUP_COUNT, 90).
-define(MARKER, "%%% BEGIN GENERATED NEUTRAL WORKLOAD").

main([]) ->
    BenchmarkDir = filename:dirname(filename:absname(escript:script_name())),
    Workload = filename:join(BenchmarkDir, "real_benchmark.erl"),
    {ok, Source0} = file:read_file(Workload),
    Source = binary:replace(Source0, <<"\r\n">>, <<"\n">>, [global]),
    Base = source_base(Source),
    Generated = generated_section(?GROUP_COUNT),
    ok = file:write_file(
           Workload,
           [string:trim(binary_to_list(Base), trailing), "\n\n", Generated]),
    io:format(
      "generated ~p neutral workload groups in ~s~n",
      [?GROUP_COUNT, Workload]);
main(_) ->
    io:format(
      standard_error,
      "usage: escript benchmark/generate_real_benchmark.escript~n",
      []),
    halt(2).

source_base(Source) ->
    Marker = list_to_binary(?MARKER),
    case binary:split(Source, Marker) of
        [Base, _Generated] -> Base;
        [Base] -> Base
    end.

generated_section(GroupCount) ->
    [
     ?MARKER, "\n",
     "%%% Generated by generate_real_benchmark.escript.\n",
     "%%% The functions below use only neutral synthetic data and operations.\n",
     "%%% END HEADER\n\n",
     dispatcher(GroupCount),
     [group(N) || N <- lists:seq(1, GroupCount)],
     "%%% END GENERATED NEUTRAL WORKLOAD\n"
    ].

dispatcher(GroupCount) ->
    Clauses = [
        io_lib:format(
          "        ~p -> neutral_route_~s(Input, #{});~n",
          [N, id(N)])
        || N <- lists:seq(1, GroupCount)
    ],
    [
     "generated_workload(Index, Input) ->\n",
     "    case Index of\n",
     Clauses,
     "        _ -> {error, unknown_workload}\n",
     "    end.\n\n"
    ].

group(N) ->
    Id = id(N),
    Tag = "neutral_" ++ Id,
    [
     validate_function(Id),
     update_function(Id, Tag, N),
     fold_function(Id, Tag, N),
     route_function(Id, Tag, N)
    ].

validate_function(Id) ->
    io_lib:format(
      "neutral_validate_~s(Value) ->~n"
      "    case Value of~n"
      "        #{kind := Kind, amount := Amount}~n"
      "          when is_atom(Kind), is_integer(Amount), Amount >= 0 ->~n"
      "            {ok, #{kind => Kind, amount => Amount + 1}};~n"
      "        #{kind := Kind} when is_atom(Kind) ->~n"
      "            {ok, #{kind => Kind, amount => 1}};~n"
      "        _ ->~n"
      "            {error, invalid_value}~n"
      "    end.~n~n",
      [Id]).

update_function(Id, Tag, N) ->
    io_lib:format(
      "neutral_update_~s(Key, State) ->~n"
      "    Entries = maps:get(entries, State, #{}),~n"
      "    Previous = maps:get(Key, Entries, #{count => 0, tags => []}),~n"
      "    Count = maps:get(count, Previous),~n"
      "    Tags = maps:get(tags, Previous),~n"
      "    Updated = Previous#{~n"
      "        count => Count + ~p,~n"
      "        tags => [~s | Tags]~n"
      "    },~n"
      "    State#{~n"
      "        entries => maps:put(Key, Updated, Entries),~n"
      "        last_key => Key~n"
      "    }.~n~n",
      [Id, N, Tag]).

fold_function(Id, Tag, N) ->
    io_lib:format(
      "neutral_fold_~s(Items, Seed) ->~n"
      "    lists:foldl(~n"
      "      fun(Item, {Count, Total, Acc}) ->~n"
      "              Value =~n"
      "                  case Item of~n"
      "                      #{value := Number} when is_number(Number) -> Number;~n"
      "                      _ -> 0~n"
      "                  end,~n"
      "              {Count + 1, Total + Value, [{~s, Item} | Acc]}~n"
      "      end,~n"
      "      {0, Seed + ~p, []},~n"
      "      Items).~n~n",
      [Id, Tag, N]).

route_function(Id, Tag, N) ->
    io_lib:format(
      "neutral_route_~s(Event, Context) ->~n"
      "    Validation = neutral_validate_~s(Event),~n"
      "    UpdatedContext = neutral_update_~s(~p, Context),~n"
      "    Items = maps:get(items, Context, []),~n"
      "    Summary = neutral_fold_~s(Items, ~p),~n"
      "    case {Validation, maps:get(enabled, Context, true)} of~n"
      "        {{ok, Normalized}, true} ->~n"
      "            {accepted,~n"
      "             #{tag => ~s, value => Normalized, summary => Summary},~n"
      "             UpdatedContext#{last_result => accepted}};~n"
      "        {{error, Reason}, true} ->~n"
      "            {rejected, Reason, UpdatedContext#{last_result => rejected}};~n"
      "        {_Result, false} ->~n"
      "            {disabled, UpdatedContext#{last_result => disabled}}~n"
      "    end.~n~n",
      [Id, Id, Id, N, Id, N, Tag]).

id(N) ->
    lists:flatten(io_lib:format("~3..0B", [N])).
