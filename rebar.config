{erl_opts, [debug_info]}.
{deps, []}.
{cover_enabled, true}.
{provider_hooks, [{post, [{ct, cover}]}]}.
{erlc_compiler, [{recursive, false}]}.
{erl_first_files, [
    "src/astranaut_monad.erl",
    "src/astranaut_error.erl",
    "src/astranaut_traverse.erl",
    "src/astranaut_return.erl",
    "src/astranaut_uniplate.erl",
    "src/astranaut_forms.erl",
    "src/astranaut.erl",
    "src/astranaut_lib.erl",
    "src/astranaut_syntax_schema.erl",
    "src/astranaut_syntax.erl",
    "src/astranaut_quote.erl",
    "src/astranaut_do.erl",
    "src/astranaut_macro_registry.erl",
    "src/astranaut_macro_expander.erl",
    "src/astranaut_macro_scan.erl",
    "src/astranaut_macro.erl",
    "src/astranaut_rebinding.erl"
]}.

{edoc_opts, [{preprocess, true}]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{project_plugins, [
    {rebar3_docker_ci,
     {git, "https://github.com/slepher/rebar3_docker_ci.git",
      {tag, "0.3.2"}}}
]}.

{docker_ci, [
    {erlang_versions, ["21", "22", "23", "24", "25", "26", "27", "28", "29"]}
]}.

{plugins, []}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all]}
    ]}
]}.
